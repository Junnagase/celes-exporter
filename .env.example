# ログイン情報は scripts/setup-keychain.sh で Keychain に登録すること。
# .env は動作確認用。使い終わったら削除する。
CELES_USER=your-login-email@example.com
CELES_PASS=your-password

# 出力先。省略時は ./output
# Googleドライブ デスクトップ版を使う場合は同期フォルダの絶対パスを指定する（案B）
# OUTPUT_DIR=/Users/you/Library/CloudStorage/GoogleDrive-you@gmail.com/マイドライブ/経費/Celes

# 対象月を明示指定したいとき（例: 2026-06）。未指定ならJST基準の前月
# TARGET_MONTH=
# アップロード済みでも強制的に再実行する場合は 1
# FORCE=1

HEADLESS=true
